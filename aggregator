import requests
import json
import os
import time

API_URL = "https://dummyjson.com/products"

HEADERS = {
    "User-Agent": "TelegramClothingAggregator/1.0"
}


def search_products(query="", limit=100):
    """
    Получает товары из DummyJSON.

    Если query указан — выполняется поиск.
    Если query пустой — получаем общий каталог.
    """

    try:
        if query:
            url = "https://dummyjson.com/products/search"
            params = {
                "q": query,
                "limit": limit
            }
        else:
            url = API_URL
            params = {
                "limit": limit
            }

        print(f"DummyJSON: запрос '{query}'")

        response = requests.get(
            url,
            params=params,
            headers=HEADERS,
            timeout=15
        )

        response.raise_for_status()

        data = response.json()

        products = data.get("products", [])

        print(f"DummyJSON: получено товаров: {len(products)}")

        return products

    except requests.RequestException as e:
        print(f"Ошибка DummyJSON: {e}")
        return []

    except ValueError:
        print("DummyJSON вернул некорректный JSON")
        return []


def convert_product(product):
    """
    Приводим товар DummyJSON
    к единому формату нашего агрегатора.
    """

    return {
        "id": product.get("id"),

        "name": product.get("title", "Без названия"),

        "brand": product.get("brand", "Без бренда"),

        "price": product.get("price", 0),

        "old_price": round(
            product.get("price", 0) /
            (1 - product.get("discountPercentage", 0) / 100),
            2
        ) if product.get("discountPercentage") else product.get("price", 0),

        "discount": product.get(
            "discountPercentage",
            0
        ),

        "rating": product.get("rating", 0),

        "stock": product.get("stock", 0),

        "category": product.get(
            "category",
            ""
        ),

        "description": product.get(
            "description",
            ""
        ),

        "image": product.get(
            "thumbnail",
            ""
        ),

        "images": product.get(
            "images",
            []
        ),

        "link": f"https://dummyjson.com/products/{product.get('id')}"
    }


def build_feed(query=""):
    """
    Создаёт фид товаров.
    """

    products = search_products(
        query=query,
        limit=100
    )

    items = []

    for product in products:
        items.append(
            convert_product(product)
        )

    feed = {
        "source": "DummyJSON",
        "query": query,
        "count": len(items),
        "updated_at": time.strftime(
            "%Y-%m-%d %H:%M:%S"
        ),
        "items": items
    }

    return feed


def save_feed(feed, filename="feed.json"):
    """
    Сохраняет фид в JSON.
    """

    if not feed.get("items"):
        print("Товары отсутствуют. Старый feed.json не изменён.")
        return False

    with open(
        filename,
        "w",
        encoding="utf-8"
    ) as file:

        json.dump(
            feed,
            file,
            ensure_ascii=False,
            indent=2
        )

    print(
        f"Фид сохранён: {len(feed['items'])} товаров"
    )

    return True


def load_feed(filename="feed.json"):
    """
    Загружает существующий фид.
    """

    if not os.path.exists(filename):
        return {
            "source": "DummyJSON",
            "query": "",
            "count": 0,
            "items": []
        }

    try:

        with open(
            filename,
            "r",
            encoding="utf-8"
        ) as file:

            return json.load(file)

    except Exception as e:

        print(f"Ошибка чтения feed.json: {e}")

        return {
            "source": "DummyJSON",
            "query": "",
            "count": 0,
            "items": []
        }
